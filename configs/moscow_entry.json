{
  "log": { "loglevel": "warning" },
  "inbounds": [{
    "port": 443, 
    "protocol": "vless",
    "settings": {
      "clients": [{ "id": "YOUR_UUID_1", "flow": "xtls-rprx-vision" }],
      "decryption": "none"
    },
    "streamSettings": {
      "network": "tcp", 
      "security": "reality",
      "realitySettings": {
        "show": false, 
        "dest": "max.ru:443", 
        "xver": 0,
        "serverNames": ["max.ru"],
        "privateKey": "YOUR_PRIVATE_KEY",
        "shortIds": ["abcdef12"]
      }
    }
  }],
  "outbounds": [{
    "protocol": "vless",
    "settings": {
      "vnext": [{ 
        "address": "KALININGRAD_IP", 
        "port": 8443, 
        "users": [{ "id": "YOUR_UUID_2" }] 
      }]
    },
    "streamSettings": {
      "network": "xhttp",
      "xhttpSettings": { 
        "path": "/api/v1/updates", 
        "mode": "packet-up" 
      }
    }
  }]
}